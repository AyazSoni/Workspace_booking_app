<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp"
    app:cardUseCompatPadding="true">

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/textViewTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Filter Rooms"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnClose"
        android:layout_marginEnd="8dp" />

    <!-- Close Button -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@android:color/transparent"
        android:src="@drawable/close3"
        android:contentDescription="Close"
        app:layout_constraintTop_toTopOf="@+id/textViewTitle"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Room Type Section -->
    <TextView
        android:id="@+id/roomTypeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room Type"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@+id/textViewTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <Spinner
        android:id="@+id/roomTypeSpinner"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/custom_input"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@+id/roomTypeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Location Section -->
    <TextView
        android:id="@+id/locationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Location"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@+id/roomTypeSpinner"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <Spinner
        android:id="@+id/locationSpinner"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/custom_input"
        android:padding="14dp"
        app:layout_constraintTop_toBottomOf="@+id/locationLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Size Section -->
    <TextView
        android:id="@+id/sizeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Capacity"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintTop_toBottomOf="@+id/locationSpinner"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp" />

    <!-- Custom Range Slider Container -->
    <FrameLayout
        android:id="@+id/rangeSliderContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/sizeLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <!-- Background Line -->
        <View
            android:id="@+id/backgroundLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#E0E0E0"
            android:layout_gravity="center_vertical" />

        <!-- Active Range Line -->
        <View
            android:id="@+id/activeRangeLine"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:background="#000000"
            android:layout_gravity="center_vertical" />

        <!-- Min Point (Left Dot) -->
        <View
            android:id="@+id/minPoint"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/circle_bg"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="0dp" />

        <!-- Max Point (Right Dot) -->
        <View
            android:id="@+id/maxPoint"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/circle_bg"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="0dp" />

    </FrameLayout>

    <!-- Range Values Text -->
    <LinearLayout
        android:id="@+id/rangeValuesContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/rangeSliderContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/minValueText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1"
            android:textSize="14sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="start" />

        <TextView
            android:id="@+id/maxValueText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100"
            android:textSize="14sp"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="end" />

    </LinearLayout>

    <!-- Computer and Projector Section in One Line -->
    <LinearLayout
        android:id="@+id/featuresContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/rangeValuesContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">

        <!-- Computer Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <ToggleButton
                android:id="@+id/computerToggle"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:textOff="Computer"
                android:textOn="Computer"
                android:padding="5dp"
                android:textSize="12sp"
                android:textColor="@color/toggle_text_colors"
                android:background="@drawable/toggle_feature_background"
                android:checked="false" />

        </LinearLayout>

        <!-- Projector Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="16dp">

            <ToggleButton
                android:id="@+id/projectorToggle"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:textOff="Projector"
                android:textOn="Projector"
                android:padding="5dp"
                android:textSize="12sp"
                android:textColor="@color/toggle_text_colors"
                android:background="@drawable/toggle_feature_background"
                android:checked="false" />

        </LinearLayout>

    </LinearLayout>

    <!-- Buttons Section -->
    <LinearLayout
        android:id="@+id/buttonsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/featuresContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Reset"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp"
            app:backgroundTint="#666666"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Apply Filters"
            android:textSize="12sp"
            android:textColor="#000000"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#000000"
            app:strokeWidth="2dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
